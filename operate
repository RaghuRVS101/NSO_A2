#!/bin/bash
# operate <openrc> <tag> <ssh_key>
set -euo pipefail

# shellcheck disable=SC1091
source "$(dirname "$0")/scripts/lib.sh"

parse_args "$@"
locate_project_root
source_openrc

if [ ! -f "$TF_DIR/terraform.tfstate" ]; then
    echo "No terraform state at $TF_DIR/terraform.tfstate. Run install first." >&2
    exit 1
fi

log "Starting operate loop for '$TAG' (Ctrl-C to stop)"

exec python3 "$SCRIPTS_DIR/operate.py" \
    --openrc "$OPENRC" \
    --tag "$TAG" \
    --ssh-key "$SSH_KEY" \
    --project-root "$PROJECT_ROOT"
