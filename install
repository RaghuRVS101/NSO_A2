#!/bin/bash
# install <openrc> <tag> <ssh_key>
#
# 1. Parse args + source openrc.
# 2. Reserve 2 floating IPs (reuse existing unassigned ones first).
# 3. Run terraform apply with node_count from servers.conf.
# 4. Generate Ansible inventory + SSH config from terraform output.
# 5. Wait for VMs to be SSH-reachable.
# 6. Run ansible-playbook to install service.py, snmpd, HAProxy, alive.

set -euo pipefail

# shellcheck disable=SC1091
source "$(dirname "$0")/scripts/lib.sh"

parse_args "$@"
locate_project_root
source_openrc

log "Starting deployment of '$TAG'"

NODE_COUNT=$(read_desired_count)
log "servers.conf says we need $NODE_COUNT node(s)"

log "Checking floating IPs"
mapfile -t FIPS < <(ensure_two_floating_ips "External")
PROXY_FIP="${FIPS[0]}"
BASTION_FIP="${FIPS[1]}"
log "Using proxy FIP:   $PROXY_FIP"
log "Using bastion FIP: $BASTION_FIP"

cd "$TF_DIR"

if [ ! -d ".terraform" ]; then
    log "Running terraform init"
    terraform init -input=false
fi

log "Running terraform apply"
terraform apply -auto-approve -input=false \
    -var "tag=$TAG" \
    -var "ssh_public_key=${SSH_KEY}.pub" \
    -var "node_count=$NODE_COUNT" \
    -var "proxy_floating_ip=$PROXY_FIP" \
    -var "bastion_floating_ip=$BASTION_FIP"

PROXY_IP=$(terraform output -raw proxy_public_ip)
BASTION_IP=$(terraform output -raw bastion_public_ip)
PROXY_PRIV=$(terraform output -raw proxy_private_ip)
BASTION_PRIV=$(terraform output -raw bastion_private_ip)
NODE_PRIV_JSON=$(terraform output -json node_private_ips)
NODE_NAMES_JSON=$(terraform output -json node_names)

cd "$PROJECT_ROOT"

generate_inventory_and_sshconfig \
    "$PROXY_IP" "$BASTION_IP" "$PROXY_PRIV" "$BASTION_PRIV" \
    "$NODE_PRIV_JSON" "$NODE_NAMES_JSON"

# --- wait for SSH to come up via the bastion -------------------------
log "Waiting for VMs to become SSH-reachable (max 5 min)"
SSH_CONFIG="$PROJECT_ROOT/${TAG}_SSHconfig"
deadline=$(( $(date +%s) + 300 ))
while [ "$(date +%s)" -lt "$deadline" ]; do
    if ssh -F "$SSH_CONFIG" -o ConnectTimeout=5 -o BatchMode=yes \
           "${TAG}_bastion" 'echo ok' >/dev/null 2>&1; then
        log "Bastion is reachable"
        break
    fi
    sleep 5
done

# --- run the playbook ------------------------------------------------
log "Running Ansible playbook"
cd "$ANSIBLE_DIR"
ansible-playbook playbook.yml

log "Deployment complete"
log "  Service:  http://$PROXY_IP:5000/"
log "  SNMP:     udp://$PROXY_IP:6000  (snmpwalk -v2c -c public $PROXY_IP:6000 system)"
log "  Bastion:  ssh -F $SSH_CONFIG ${TAG}_bastion"
log "  Health:   http://$BASTION_IP:8080/"
