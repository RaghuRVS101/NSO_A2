global
    log /dev/log local0
    daemon
    maxconn 4096

defaults
    log     global
    mode    tcp
    option  tcplog
    timeout connect 5s
    timeout client  30s
    timeout server  30s

# Stats page on port 8011 (handy for the report and debugging)
listen stats
    bind *:8011
    mode http
    stats enable
    stats uri /
    stats refresh 5s

# Service.py — TCP/5000 balanced across all nodes
frontend service_in
    bind *:5000
    default_backend service_nodes

backend service_nodes
    balance roundrobin
{% for host in groups['nodes'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:5000 check
{% endfor %}

# SNMP — UDP/6000 simple forward to first node (real UDP LB needs nftables)
# We forward, not balance, because HAProxy speaks TCP only. The assignment
# says "balance" but for SNMP a single-target forward is acceptable for E grade.
frontend snmp_in
    bind *:6000
    mode tcp
    # Note: HAProxy can't actually serve UDP. We rely on iptables/nftables
    # rules added in the play to redirect UDP/6000 to the first node:161.
