#!/bin/bash
# cleanup <openrc> <tag> <ssh_key>
set -euo pipefail

# shellcheck disable=SC1091
source "$(dirname "$0")/scripts/lib.sh"

parse_args "$@"
locate_project_root
source_openrc

log "Starting cleanup of '$TAG'"

cd "$TF_DIR"
if [ ! -f "terraform.tfstate" ]; then
    log "No terraform state — skipping destroy"
else
    PROXY_FIP=$(terraform output -raw proxy_public_ip 2>/dev/null || echo "0.0.0.0")
    BASTION_FIP=$(terraform output -raw bastion_public_ip 2>/dev/null || echo "0.0.0.0")
    NODE_COUNT=$(terraform output -json node_private_ips 2>/dev/null \
                 | python3 -c 'import json,sys;print(len(json.load(sys.stdin)))' \
                 || echo 0)
FLAVOR="2C-2GB-20GB"
if ! openstack flavor show "$FLAVOR" >/dev/null 2>&1; then
    log "Flavor $FLAVOR not found, falling back to tiny"
    FLAVOR="tiny"
fi

EXT_NET="ext-net"
if ! openstack network show "$EXT_NET" >/dev/null 2>&1; then
    log "External network $EXT_NET not found, falling back to External"
    EXT_NET="External"
fi

    log "Running terraform destroy"
    terraform destroy -auto-approve -input=false \
        -var "tag=$TAG" \
        -var "ssh_public_key=${SSH_KEY}.pub" \
        -var "node_count=$NODE_COUNT" \
        -var "flavor_name=$FLAVOR" \
        -var "external_network=$EXT_NET" \
        -var "dns_nameserver=1.1.1.1" \
        -var "proxy_floating_ip=$PROXY_FIP" \
        -var "bastion_floating_ip=$BASTION_FIP"
fi

cd "$PROJECT_ROOT"

log "Releasing floating IPs tagged '$TAG'"
TAGGED_FIPS=$(openstack floating ip list --tags "$TAG" \
              -f value -c "Floating IP Address" 2>/dev/null || true)
if [ -n "$TAGGED_FIPS" ]; then
    while IFS= read -r ip; do
        [ -z "$ip" ] && continue
        log "  Deleting $ip"
        openstack floating ip delete "$ip" || true
    done <<< "$TAGGED_FIPS"
else
    log "  No tagged FIPs to release"
fi

log "Removing generated config files"
rm -f "$PROJECT_ROOT/${TAG}_SSHconfig"
rm -f "$ANSIBLE_DIR/inventory.ini"
rm -f "$TF_DIR/terraform.tfstate" "$TF_DIR/terraform.tfstate.backup"

log "Cleanup complete"
